Project anomaly_detection_platform {
  database_type: 'PostgreSQL'
  Note: 'Skema platform deteksi anomali — 42 tabel. Sumber: backend/anomaly_backend/tables.py. Kolom IDENTITY (Postgres): live_processing_boundaries.boundary_id, live_model_activations.activation_id, live_telemetry.ingress_sequence.'
}

Table devices {
  device_id text [pk]
  display_name text [not null]
  source_device_uuid text
  time_zone text
  telemetry_kind text [not null]
  is_active boolean [not null]
  archived_at timestamptz
}

Table corpora {
  corpus_id text [pk]
  device_id text [not null, ref: > devices.device_id]
  status text [not null]
  archive_sha256 text [not null]
  member_sha256 text
  preprocessing_contract_version text [not null]
  source_device_uuid text
  time_zone text
  interval_start timestamp
  interval_end timestamp
  filter_config jsonb [not null]
  started_at timestamptz [not null]
  completed_at timestamptz
  accepted_count bigint [not null]
  ignored_index_count bigint [not null]
  rejection_counts jsonb [not null]

  indexes {
    (device_id, archive_sha256, preprocessing_contract_version) [unique]
  }
}

Table injection_events {
  event_id text [pk]
  corpus_id text [not null, ref: > corpora.corpus_id]
  device_id text [not null, ref: > devices.device_id]
  family text [not null]
  severity text [not null]
  channel text [not null]
  channel_index int [not null]
  start_idx bigint [not null]
  end_idx_exclusive bigint [not null]
  start_ts timestamp [not null]
  end_ts timestamp [not null]
  segment_index int [not null]
}

Table published_corpora {
  device_id text [pk, ref: > devices.device_id]
  corpus_id text [not null, unique, ref: > corpora.corpus_id]
  published_at timestamptz [not null]
}

Table preprocessing_snapshots {
  corpus_id text [pk, ref: > corpora.corpus_id]
  channels jsonb [not null]
  window_size int [not null]
  stride int [not null]
  contract_status text [not null]
  segment_metadata jsonb [not null]
  split_boundaries jsonb [not null]
  split_counts jsonb [not null]
  scaler jsonb [not null]
}

Table telemetry {
  device_id text [not null, ref: > devices.device_id]
  ts timestamp [not null]
  temperature_c double
  relative_humidity_pct double
  payload_hash text [not null]
  source_index bigint [not null]
  corpus_id text [not null, ref: > corpora.corpus_id]
  corpus_index bigint [not null]
  segment_id int [not null]
  dataset_split text [not null]

  indexes {
    (device_id, ts) [pk]
  }
}

Table eda_source_snapshots {
  id uuid [pk]
  dataset_id text [not null]
  source_sha256 text [not null]
  manifest_sha256 text [not null]
  config_hash text [not null]
  source_from_ts timestamp [not null]
  source_to_ts timestamp [not null]
  expected_row_count bigint [not null]
  expected_channel_count int [not null]
  importer_version text [not null]
  status text [not null]
  created_at timestamptz [not null]
  completed_at timestamptz
  manifest jsonb [not null]

  indexes {
    (dataset_id, source_sha256) [unique]
    (id, source_sha256) [unique]
  }
}

Table eda_raw_readings {
  snapshot_id uuid [not null, ref: > eda_source_snapshots.id]
  source_row_number bigint [not null]
  device_id text [not null]
  data_index int [not null]
  value double [not null]
  ts timestamp [not null]
  is_connected boolean [not null]

  indexes {
    (snapshot_id, source_row_number, ts) [pk]
  }
}

Table eda_jobs {
  id uuid [pk]
  logical_key text [not null]
  snapshot_id uuid [not null]
  source_sha256 text [not null]
  from_ts timestamp [not null]
  to_ts timestamp [not null]
  period_kind text [not null]
  algorithm_version text [not null]
  config_hash text [not null]
  status text [not null]
  attempt_count int [not null]
  max_attempts int [not null]
  trigger_kind text [not null]
  lease_owner text
  lease_until timestamptz
  terminal boolean [not null]
  error_code text
  error_detail text
  created_at timestamptz [not null]
  started_at timestamptz
  completed_at timestamptz
}

Table eda_runs {
  id uuid [pk]
  logical_key text [not null, unique]
  snapshot_id uuid [not null]
  source_sha256 text [not null]
  from_ts timestamp [not null]
  to_ts timestamp [not null]
  period_kind text [not null]
  algorithm_version text [not null]
  config_hash text [not null]
  provenance jsonb [not null]
  canonical_release boolean [not null]
  completed_at timestamptz [not null]
}

Table eda_result_sections {
  run_id uuid [not null, ref: > eda_runs.id]
  section text [not null]
  status text [not null]
  reason_code text
  reason_detail text
  payload jsonb
  payload_sha256 text
  created_at timestamptz [not null]

  indexes {
    (run_id, section) [unique]
  }
}

Table model_families {
  model_key text [pk]
  display_name text [not null]
  is_public boolean [not null]
}

Table model_versions {
  version text [pk]
  model_key text [not null, ref: > model_families.model_key]
  runtime_kind text [not null]
  is_selectable boolean [not null]
  adapter_key text [not null]
  schema_version text [not null]
  channels jsonb [not null]
  window_size int [not null]
  stride int [not null]
  contract_status text [not null]
  score_key text [not null]
  score_semantics text [not null]
  threshold double [not null]
  threshold_policy jsonb [not null]
  temporal_semantics text [not null]
  source_commit text
  source_config text
  manifest_sha256 text
  model_manifest_sha256 text
  checkpoint_sha256 text
  scaler_manifest_sha256 text
  scaler_sha256 text
  created_at timestamptz [not null]
}

Table model_activations {
  activation_id text [pk]
  command_id text [not null, unique]
  payload_hash text [not null]
  device_id text [not null, ref: > devices.device_id]
  prior_model_version text [ref: > model_versions.version]
  model_version text [not null, ref: > model_versions.version]
  changed boolean [not null]
  activated_at timestamptz [not null]
  actor text [not null]
}

Table active_model_selections {
  device_id text [pk, ref: > devices.device_id]
  activation_id text [not null, unique, ref: > model_activations.activation_id]
  model_version text [not null, ref: > model_versions.version]
}

Table replay_jobs {
  job_id text [pk]
  logical_job_hash text [not null]
  device_id text [not null, ref: > devices.device_id]
  corpus_id text [not null, ref: > corpora.corpus_id]
  archive_sha256 text [not null]
  preprocessing_contract_version text [not null]
  activation_id text [not null, ref: > model_activations.activation_id]
  model_version text [not null, ref: > model_versions.version]
  score_provenance text [not null]
  from_ts timestamp [not null]
  to_ts timestamp [not null]
  replay_range tsrange [not null, note: 'GENERATED tsrange(from_ts, to_ts, [) )']
  status text [not null]
  lease_owner text
  lease_expires_at timestamptz
  heartbeat_at timestamptz
  attempt_count int [not null]
  max_attempts int [not null]
  next_corpus_index bigint [not null]
  processed_count bigint [not null]
  result_count bigint [not null]
  episode_count bigint [not null]
  submitted_at timestamptz [not null]
  started_at timestamptz
  completed_at timestamptz
  error_code text
  error_detail text
}

Table replay_commands {
  command_id text [pk]
  payload_hash text [not null]
  job_id text [not null, ref: > replay_jobs.job_id]
  accepted_at timestamptz [not null]
}

Table replay_result_staging {
  job_id text [not null, ref: > replay_jobs.job_id]
  score_ts timestamp [not null]
  window_start_ts timestamp [not null]
  window_end_ts timestamp [not null]
  model_version text [not null]
  score double [not null]
  threshold double [not null]
  is_anomaly boolean [not null]
  score_provenance text [not null]
  source_start_index bigint [not null]
  source_end_index bigint [not null]
  reading_count int [not null]
  stride int [not null]
  segment_id int [not null]
  eligible_window_ordinal bigint [not null]
  recon_temperature_c double
  recon_relative_humidity_pct double
  band_half_temperature_c double
  band_half_relative_humidity_pct double

  indexes {
    (job_id, score_ts) [pk]
  }
}

Table replay_episode_staging {
  job_id text [not null, ref: > replay_jobs.job_id]
  episode_ordinal int [not null]
