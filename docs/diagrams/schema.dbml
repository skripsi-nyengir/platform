Ref: eda_jobs.(snapshot_id, source_sha256) > eda_source_snapshots.(id, source_sha256)
Ref: eda_runs.(snapshot_id, source_sha256) > eda_source_snapshots.(id, source_sha256)
Ref: alerts.(alert_id, live_episode_id) > live_alert_episodes.(alert_id, live_episode_id)
Ref: live_model_pairs.(model_version, contract_status, model_manifest_sha256, checkpoint_sha256, scaler_manifest_sha256, scaler_sha256) > model_versions.(version, contract_status, model_manifest_sha256, checkpoint_sha256, scaler_manifest_sha256, scaler_sha256)
Ref: live_model_pairs.(scaler_snapshot_corpus_id, contract_status) > preprocessing_snapshots.(corpus_id, contract_status)
Ref: live_model_activations.(request_id, device_id, model_pair_id) > live_model_activation_requests.(request_id, device_id, model_pair_id)
Ref: live_model_selections.(activation_event_id, device_id, activation_id, model_pair_id) > live_model_activations.(activation_event_id, device_id, activation_id, model_pair_id)
Ref: live_telemetry.(device_id, activation_id) > live_model_activations.(device_id, activation_id)
Ref: live_inference.(device_id, activation_id, model_pair_id) > live_model_activations.(device_id, activation_id, model_pair_id)
Ref: live_inference.(model_pair_id, model_version, snapshot_corpus_id) > live_model_pairs.(model_pair_id, model_version, scaler_snapshot_corpus_id)
Ref: live_inference_sources.(score_ts, inference_id, device_id) > live_inference.(score_ts, inference_id, device_id)
Ref: live_inference_sources.(received_ts, telemetry_id, device_id) > live_telemetry.(received_ts, telemetry_id, device_id)
Ref: live_processing_boundaries.(after_received_ts, after_telemetry_id, device_id) > live_telemetry.(received_ts, telemetry_id, device_id)
Ref: live_cursors.(received_ts, telemetry_id, device_id) > live_telemetry.(received_ts, telemetry_id, device_id)
Ref: live_cursors.(last_boundary_id, device_id) > live_processing_boundaries.(boundary_id, device_id)
Ref: live_alert_episodes.(device_id, activation_id, model_pair_id) > live_model_activations.(device_id, activation_id, model_pair_id)
Ref: live_alert_episodes.(model_pair_id, model_version, snapshot_corpus_id) > live_model_pairs.(model_pair_id, model_version, scaler_snapshot_corpus_id)
Ref: live_alert_episode_points.(live_episode_id, device_id, model_pair_id, activation_id, continuity_epoch, model_version, snapshot_corpus_id) > live_alert_episodes.(live_episode_id, device_id, model_pair_id, activation_id, continuity_epoch, model_version, snapshot_corpus_id)
Ref: live_alert_episode_points.(score_ts, inference_id, device_id, model_pair_id, activation_id, continuity_epoch, model_version, snapshot_corpus_id) > live_inference.(score_ts, inference_id, device_id, model_pair_id, activation_id, continuity_epoch, model_version, snapshot_corpus_id)

