POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=<database-name>
POSTGRES_USER=<database-user>
POSTGRES_PASSWORD=<database-password>
NGINX_PORT=8080
APP_HOST=anomaly.mytekna.io

# Login. Every /api path except /health and /ready requires a session cookie.
# Accounts are created with:
#   docker compose run --rm api python -m anomaly_backend.auth_cli create-user <name>
# Set AUTH_COOKIE_SECURE=false for local http development; a Secure cookie is
# discarded by the browser over plain http and the session never sticks.
AUTH_COOKIE_SECURE=true
AUTH_SESSION_TTL_SECONDS=43200
AUTH_MAX_FAILED_ATTEMPTS=5
AUTH_LOCKOUT_SECONDS=900
# Used by scripts/deploy/anomaly-platform-deploy to read /api/system/status while
# verifying a release. Must match an account created with auth_cli.
AUTH_VERIFY_USERNAME=<deploy-verification-username>
AUTH_VERIFY_PASSWORD=<deploy-verification-password>
INFERENCE_CPU_THREADS=1
B02_RAW_ARCHIVE_PATH=./REPLACE_WITH_LEGACY_B02_ARCHIVE.tar.gz

# Live MQTT subscriber placeholders. Username and password are an optional pair.
MQTT_BROKER_HOST=<mqtt-broker-host>
MQTT_BROKER_PORT=<mqtt-broker-port>
MQTT_TOPIC=<mqtt-topic>
# MQTT_USERNAME=<mqtt-username>
# MQTT_PASSWORD=<mqtt-password>
MQTT_CLIENT_ID=<mqtt-client-id>
MODEL_ARTIFACTS_DIR=<model-artifacts-directory>
LIVE_MODEL_BUNDLE_ID=<primary-live-model-bundle-id>
# LIVE_MODEL_BUNDLE_IDS=<comma-separated-live-model-bundle-ids>

# B02 v3 EDA worker. The heartbeat must be shorter than the lease.
EDA_WORKER_LEASE_SECONDS=900
EDA_WORKER_HEARTBEAT_SECONDS=30
EDA_WORKER_MAX_ATTEMPTS=3
EDA_WORKER_COMPUTE_TIMEOUT_SECONDS=1800

# B02 v3 canonical raw import. Set both host paths before using the eda-import profile.
EDA_RAW_SOURCE_PATH=./REPLACE_WITH_B02_V3_SOURCE/sensor_data_long.csv
EDA_SOURCE_MANIFEST_PATH=./REPLACE_WITH_B02_V3_SOURCE/source-manifest.json
EDA_SOURCE_MANIFEST_SHA256=196178e7424bd2e92268606f0ef33237d2329bdfefd9dce592283c07a697d486

# Audit placeholders only. Compose and the runtime do not read these values.
# EDA_ALGORITHM_VERSION=<verify-from-eda-worker>
# EDA_CONFIG_HASH=<verify-from-eda-worker>
# EDA_MIGRATION_HEAD=<verify-with-alembic-heads>
